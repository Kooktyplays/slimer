# Exported builds. The desktop builds ship as GitHub release assets instead -
# they are ~240 MB together and do not belong in git history.
build/

# site/assets/ and site/play/engine/ ARE committed, despite being generated by
# site/tools/build_site.py. Vercel deploys this repo as static files with no
# build step - and it could not run one anyway, since the web build comes out of
# a Godot export that cannot run on a build server. So the deployed artefacts
# have to live in git. Regenerate them with:
#     python3 site/tools/build_site.py

# The original GDQuest pack, unmodified and not ours to redistribute wholesale.
# The handful of files the game actually derives from are committed under
# game/assets/sprites/ with attribution - see game/LICENSE-ASSETS.md.
2d-project-assets/

# Stale artifacts from an early export, before the build/ layout existed.
# See HANDOVER.md section 1.
/Slimer.app/
/Slimer.exe
/Slimer.console.exe
/Slimer.pck
/Slimer-macos.zip
/Slimer.zip
/slimer.html

# The four source mp3s live at game/assets/music/ where the project imports
# them; these root copies are duplicates.
/*.mp3

.DS_Store
*.tmp

# Godot's import cache and editor-local state. Regenerated on first open.
.godot/
*.translation

# Vercel
.vercel

# Where background agent sessions check the repo out - a full copy of the tree,
# nested inside the tree. Leading **/ because a pattern with a slash in it is
# anchored to this file's directory, and these appear under subdirectories too.
**/.claude/worktrees/
